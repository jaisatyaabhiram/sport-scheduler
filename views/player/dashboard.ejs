<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Player Dashboard - Sport Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <h1>Welcome, <%= locals.user.name %>!</h1>        
        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="stat-number"><%= createdSessions.length %></div>
                <div>Sessions Created</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= joinedSessions.length %></div>
                <div>Sessions Joined</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= availableSessions.length %></div>
                <div>Available Sessions</div>
            </div>
        </div>

        <div style="margin: 30px 0;">
            <a href="/sessions/create" class="btn">Create New Session</a>
        </div>

        <!-- Created Sessions -->
        <div class="card">
            <h2>My Created Sessions</h2>
            <% if (createdSessions.length === 0) { %>
                <p>You haven't created any sessions yet.</p>
            <% } else { %>
                <div class="sessions-grid">
                    <% createdSessions.forEach(session => { %>
                        <div class="session-card <%= session.status === 'cancelled' ? 'cancelled' : '' %>">
                            <h3><%= session.sport %></h3>
                            <div class="session-meta">
                                <strong>Date:</strong> <%= session.dateTime.toDate().toLocaleString() %><br>
                                <strong>Venue:</strong> <%= session.venue %><br>
                                <strong>Players:</strong> <%= session.players.length %>
                            </div>
                            <% if (session.status === 'cancelled') { %>
                                <p><strong>Cancelled:</strong> <%= session.cancellationReason %></p>
                            <% } else { %>
                                <form action="/sessions/<%= session.id %>/cancel" method="POST" style="margin-top: 10px;">
                                    <div class="form-group">
                                        <input type="text" name="reason" placeholder="Cancellation reason" required>
                                    </div>
                                    <button type="submit" class="btn" style="background: #e74c3c;">Cancel Session</button>
                                </form>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <!-- Joined Sessions -->
        <div class="card">
            <h2>Sessions I've Joined</h2>
            <% if (joinedSessions.length === 0) { %>
                <p>You haven't joined any sessions yet.</p>
            <% } else { %>
                <div class="sessions-grid">
                    <% joinedSessions.forEach(session => { %>
                        <div class="session-card <%= session.status === 'cancelled' ? 'cancelled' : '' %>">
                            <h3><%= session.sport %></h3>
                            <div class="session-meta">
                                <strong>Date:</strong> <%= session.dateTime.toDate().toLocaleString() %><br>
                                <strong>Venue:</strong> <%= session.venue %><br>
                                <strong>Created by:</strong> <%= session.createdBy %>
                            </div>
                            <% if (session.status === 'cancelled') { %>
                                <p><strong>Cancelled:</strong> <%= session.cancellationReason %></p>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <!-- Available Sessions -->
        <div class="card">
            <h2>Available Sessions</h2>
            <% if (availableSessions.length === 0) { %>
                <p>No available sessions at the moment.</p>
            <% } else { %>
                <div class="sessions-grid">
                    <% availableSessions.forEach(session => { %>
                        <% if (!session.players.includes(user.id) && session.createdBy !== user.id) { %>
                            <div class="session-card">
                                <h3><%= session.sport %></h3>
                                <div class="session-meta">
                                    <strong>Date:</strong> <%= session.dateTime.toDate().toLocaleString() %><br>
                                    <strong>Venue:</strong> <%= session.venue %><br>
                                    <strong>Players needed:</strong> <%= session.additionalPlayers %>
                                </div>
                                <form action="/sessions/<%= session.id %>/join" method="POST" style="margin-top: 10px;">
                                    <button type="submit" class="btn">Join Session</button>
                                </form>
                            </div>
                        <% } %>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>