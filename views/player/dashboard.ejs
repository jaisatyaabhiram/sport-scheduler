<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Player Dashboard - Sport Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <h1>Welcome, <%= locals.user.name %>!</h1>
        
        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="stat-number"><%= appliedSessions.length %></div>
                <div>Sessions Applied</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    <%= appliedSessions.filter(s => s.application && s.application.status === 'accepted').length %>
                </div>
                <div>Sessions Accepted</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">
                    <%= availableSessions.filter(s => !s.hasApplied).length %>
                </div>
                <div>Available Sessions</div>
            </div>
        </div>

        <!-- Available Sessions -->
        <div class="card">
            <h2>Available Sessions</h2>
            <% const availableToApply = availableSessions.filter(s => !s.hasApplied); %>
            <% if (availableToApply.length === 0) { %>
                <p>No available sessions at the moment. Check back later!</p>
            <% } else { %>
                <div class="sessions-grid">
                    <% availableToApply.forEach(session => { %>
                        <div class="session-card">
                            <h3><%= session.sport %></h3>
                            <div class="session-meta">
                                <strong>Date:</strong> <%= session.dateTime.toDate().toLocaleString() %><br>
                                <strong>Venue:</strong> <%= session.venue %><br>
                                <strong>Players:</strong> <%= session.players ? session.players.length : 0 %>/<%= session.maxPlayers %><br>
                                <strong>Status:</strong> <%= session.status %>
                            </div>
                            <form action="/sessions/<%= session.id %>/apply" method="POST" style="margin-top: 10px;">
                                <button type="submit" class="btn">Apply to Join</button>
                            </form>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
        <div class="card">
            <a href="/sessions/create" class="btn" style="width: 100%;">Create New Sport Session</a>
        </div>

        <!-- Sessions I've Applied To -->
        <div class="card">
            <h2>My Applications</h2>
            <% if (appliedSessions.length === 0) { %>
                <p>You haven't applied to any sessions yet.</p>
            <% } else { %>
                <div class="sessions-grid">
                    <% appliedSessions.forEach(session => { %>
                        <div class="session-card">
                            <h3><%= session.sport %></h3>
                            <div class="session-meta">
                                <strong>Date:</strong> <%= session.dateTime.toDate().toLocaleString() %><br>
                                <strong>Venue:</strong> <%= session.venue %><br>
                                <strong>Application Status:</strong> 
                                <span style="color: 
                                    <%= session.application.status === 'accepted' ? '#27ae60' : 
                                       session.application.status === 'rejected' ? '#e74c3c' : '#f39c12' %>">
                                    <%= session.application.status.toUpperCase() %>
                                </span>
                                <% if (session.application.processedAt) { %>
                                    <br><strong>Processed:</strong> <%= session.application.processedAt.toDate().toLocaleString() %>
                                <% } %>
                            </div>
                            <% if (session.application.status === 'pending') { %>
                                <p style="color: #f39c12; margin-top: 10px;">
                                    <strong>Waiting for admin approval</strong>
                                </p>
                            <% } else if (session.application.status === 'accepted') { %>
                                <p style="color: #27ae60; margin-top: 10px;">
                                    <strong>✓ You're in! See you at the session.</strong>
                                </p>
                            <% } else if (session.application.status === 'rejected') { %>
                                <p style="color: #e74c3c; margin-top: 10px;">
                                    <strong>Application not accepted</strong>
                                </p>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>