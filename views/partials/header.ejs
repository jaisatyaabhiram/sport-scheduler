<header>
    <nav class="container">
        <div class="logo">
            <a href="/" style="color: white; text-decoration: none;">Sport Scheduler</a>
        </div>
        <ul class="nav-links">
            <% if (locals.user) { %>
                <li><a href="/dashboard">Dashboard</a></li>
                <% if (locals.user.role === 'admin') { %>
                    <li><a href="/admin/sports">Sports</a></li>
                    <li><a href="/sessions/create">Create Session</a></li>
                    <li><a href="/admin/reports">Reports</a></li>
                <% } %>
                <li><a href="/logout">Logout (<%= locals.user.name %>)</a></li>
            <% } else { %>
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
            <% } %>
        </ul>
    </nav>
</header>