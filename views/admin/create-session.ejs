<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Session - Sport Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <div class="card" style="max-width: 600px; margin: 30px auto;">
            <h2>Create New Sport Session</h2>
            
            <form action="/sessions/create" method="POST">
                <div class="form-group">
                    <label for="sport">Sport:</label>
                    <select id="sport" name="sport" required>
                        <option value="">Select a sport</option>
                        <% sports.forEach(sport => { %>
                            <option value="<%= sport.name %>"><%= sport.name %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="teamAPlayers">Team A Players (comma separated):</label>
                    <input type="text" id="teamAPlayers" name="teamAPlayers" placeholder="Player1, Player2, Player3">
                </div>

                <div class="form-group">
                    <label for="teamBPlayers">Team B Players (comma separated):</label>
                    <input type="text" id="teamBPlayers" name="teamBPlayers" placeholder="Player4, Player5, Player6">
                </div>

                <div class="form-group">
                    <label for="additionalPlayers">Additional Players Needed:</label>
                    <input type="number" id="additionalPlayers" name="additionalPlayers" min="0" value="0">
                </div>

                <div class="form-group">
                    <label for="dateTime">Date and Time:</label>
                    <input type="datetime-local" id="dateTime" name="dateTime" required>
                </div>

                <div class="form-group">
                    <label for="venue">Venue:</label>
                    <input type="text" id="venue" name="venue" required placeholder="e.g., Central Park, Sports Complex">
                </div>

                <button type="submit" class="btn" style="width: 100%;">Create Session</button>
            </form>
        </div>
    </div>
