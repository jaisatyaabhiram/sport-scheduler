<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isOverview ? 'All Session Applications' : 'Session Applications' %> - Sport Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <% if (isOverview) { %>
            <h1>All Session Applications</h1>
            
            <% sessions.forEach(sessionGroup => { %>
                <div class="card">
                    <h2>Session: <%= sessionGroup.session.sport %> at <%= sessionGroup.session.venue %></h2>
                    <p><strong>Date:</strong> <%= sessionGroup.session.dateTime.toDate().toLocaleString() %></p>
                    <p><strong>Max Players:</strong> <%= sessionGroup.session.maxPlayers %></p>
                    <p><strong>Current Players:</strong> <%= sessionGroup.session.players ? sessionGroup.session.players.length : 0 %></p>
                    
                    <h3>Pending Applications (<%= sessionGroup.applications.filter(app => app.status === 'pending').length %>)</h3>
                    <% if (sessionGroup.applications.filter(app => app.status === 'pending').length === 0) { %>
                        <p>No pending applications for this session.</p>
                    <% } else { %>
                        <div class="sessions-grid">
                            <% sessionGroup.applications.forEach(application => { %>
                                <% if (application.status === 'pending') { %>
                                    <div class="session-card">
                                        <h3><%= application.playerName %></h3>
                                        <div class="session-meta">
                                            <strong>Email:</strong> <%= application.playerEmail %><br>
                                            <strong>Applied:</strong> <%= application.appliedAt.toDate().toLocaleString() %>
                                        </div>
                                        <div style="display: flex; gap: 10px; margin-top: 10px;">
                                            <form action="/admin/applications/<%= application.id %>/accept" method="POST">
                                                <button type="submit" class="btn" style="background: #27ae60;">Accept</button>
                                            </form>
                                            <form action="/admin/applications/<%= application.id %>/reject" method="POST">
                                                <button type="submit" class="btn" style="background: #e74c3c;">Reject</button>
                                            </form>
                                        </div>
                                    </div>
                                <% } %>
                            <% }); %>
                        </div>
                    <% } %>

                    <h3>Processed Applications (<%= sessionGroup.applications.filter(app => app.status !== 'pending').length %>)</h3>
                    <% const processedApps = sessionGroup.applications.filter(app => app.status !== 'pending'); %>
                    <% if (processedApps.length === 0) { %>
                        <p>No processed applications.</p>
                    <% } else { %>
                        <div class="sessions-grid">
                            <% processedApps.forEach(application => { %>
                                <div class="session-card">
                                    <h3><%= application.playerName %></h3>
                                    <div class="session-meta">
                                        <strong>Email:</strong> <%= application.playerEmail %><br>
                                        <strong>Status:</strong> 
                                        <span style="color: <%= application.status === 'accepted' ? '#27ae60' : '#e74c3c' %>;">
                                            <%= application.status.toUpperCase() %>
                                        </span><br>
                                        <% if (application.processedAt) { %>
                                            <strong>Processed:</strong> <%= application.processedAt.toDate().toLocaleString() %>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                    
                    <div style="margin-top: 20px;">
                        <a href="/admin/sessions/<%= sessionGroup.session.id %>/applications" class="btn" style="background: #3498db; color: white;">
                            View Detailed Applications
                        </a>
                    </div>
                </div>
            <% }); %>

        <% } else { %>
            <h1>Session Applications</h1>
            
            <div class="card">
                <h2>Session Details</h2>
                <p><strong>Sport:</strong> <%= session.sport %></p>
                <p><strong>Date:</strong> <%= session.dateTime.toDate().toLocaleString() %></p>
                <p><strong>Venue:</strong> <%= session.venue %></p>
                <p><strong>Max Players:</strong> <%= session.maxPlayers %></p>
                <p><strong>Current Players:</strong> <%= session.players ? session.players.length : 0 %></p>
            </div>

            <div class="card">
                <h2>Pending Applications</h2>
                <% if (applications.filter(app => app.status === 'pending').length === 0) { %>
                    <p>No pending applications for this session.</p>
                <% } else { %>
                    <div class="sessions-grid">
                        <% applications.forEach(application => { %>
                            <% if (application.status === 'pending') { %>
                                <div class="session-card">
                                    <h3><%= application.playerName %></h3>
                                    <div class="session-meta">
                                        <strong>Email:</strong> <%= application.playerEmail %><br>
                                        <strong>Applied:</strong> <%= application.appliedAt.toDate().toLocaleString() %>
                                    </div>
                                    <div style="display: flex; gap: 10px; margin-top: 10px;">
                                        <form action="/admin/applications/<%= application.id %>/accept" method="POST">
                                            <button type="submit" class="btn" style="background: #27ae60;">Accept</button>
                                        </form>
                                        <form action="/admin/applications/<%= application.id %>/reject" method="POST">
                                            <button type="submit" class="btn" style="background: #e74c3c;">Reject</button>
                                        </form>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <div class="card">
                <h2>Processed Applications</h2>
                <% const processedApps = applications.filter(app => app.status !== 'pending'); %>
                <% if (processedApps.length === 0) { %>
                    <p>No processed applications.</p>
                <% } else { %>
                    <div class="sessions-grid">
                        <% processedApps.forEach(application => { %>
                            <div class="session-card">
                                <h3><%= application.playerName %></h3>
                                <div class="session-meta">
                                    <strong>Email:</strong> <%= application.playerEmail %><br>
                                    <strong>Status:</strong> 
                                    <span style="color: <%= application.status === 'accepted' ? '#27ae60' : '#e74c3c' %>;">
                                        <%= application.status.toUpperCase() %>
                                    </span><br>
                                    <strong>Processed:</strong> <%= application.processedAt.toDate().toLocaleString() %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <div style="margin-top: 20px;">
                <a href="/admin/session-applications" class="btn" style="background: #3498db; color: white;">
                    Back to All Applications
                </a>
            </div>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>