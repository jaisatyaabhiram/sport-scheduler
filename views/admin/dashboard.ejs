<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Sport Scheduler</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <h1>Admin Dashboard</h1>
        <p>Welcome, <%= locals.user.name %> (Administrator)</p>

        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="stat-number"><%= sports.length %></div>
                <div>Sports Created</div>
            </div>
        </div>

        <div style="margin: 30px 0; display: flex; gap: 10px;">
            <a href="/admin/sports" class="btn">Manage Sports</a>
            <a href="/admin/reports" class="btn">View Reports</a>
            <a href="/admin/session-applications" class="btn">session applications</a>
        </div>

        <!-- Recent Sports -->
        <div class="card">
            <h2>My Sports</h2>
            <% if (sports.length === 0) { %>
                <p>You haven't created any sports yet.</p>
            <% } else { %>
                <ul>
                    <% sports.forEach(sport => { %>
                        <li style="padding: 10px; border-bottom: 1px solid #eee;">
                            <strong><%= sport.name %></strong>
                            <br><small>Created: <%= sport.createdAt.toDate().toLocaleDateString() %></small>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </div>
    </div>


    <%- include('../partials/footer') %>
</body>
</html>